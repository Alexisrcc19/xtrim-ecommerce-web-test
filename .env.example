# Base de la API Express, con /api/v1 y sin barra final. Es pública.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# URL del frontend para canonical, sitemap y robots. Cambiar al desplegar.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CRM: todas estas variables son privadas y se usan SOLO en el servidor.
API_URL=http://localhost:4000/api/v1
ADMIN_API_TOKEN=
ADMIN_USERNAME=
# Formato scrypt:saltHex:hashHex; generar con scripts/hash-admin-password.mjs.
ADMIN_PASSWORD_HASH=
# Secreto aleatorio de al menos 32 caracteres; no reutilizar el token de Express.
ADMIN_SESSION_SECRET=
